---
import tood from '../data/tehtud-tood.json';
---

<div class="portfolio">
  {tood.map((item) => (
    <article class="portfolio__card">
      <div class="portfolio__photo" role="img" aria-label="Objekti foto (näidiskoht)"></div>
      <span class="mono portfolio__object">{item.objekt}</span>
      <h3>{item.pealkiri}</h3>
      <p>{item.kirjeldus}</p>
      <span class="mono portfolio__result">{item.tulemus}</span>
    </article>
  ))}
</div>

<style>
  .portfolio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .portfolio__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .portfolio__photo {
    height: 160px;
    background-image: repeating-linear-gradient(
      45deg,
      var(--surface-2),
      var(--surface-2) 10px,
      var(--surface) 10px,
      var(--surface) 20px
    );
    border-bottom: 1px solid var(--line);
  }
  .portfolio__card > *:not(.portfolio__photo) { padding-left: 22px; padding-right: 22px; }
  .portfolio__object {
    display: block;
    margin-top: 18px;
    font-size: 0.72rem;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .portfolio__card h3 { margin-top: 8px; }
  .portfolio__card p { color: var(--ink-2); font-size: 0.9rem; }
  .portfolio__result {
    display: block;
    color: var(--return);
    font-weight: 700;
    font-size: 0.95rem;
    padding-bottom: 22px;
  }

  @media (max-width: 820px) {
    .portfolio { grid-template-columns: 1fr; }
  }
</style>
