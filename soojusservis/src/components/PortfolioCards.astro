---
import tood from '../data/tehtud-tood.json';
---

<div class="portfolio">
  {tood.map((item) => (
    <article class="portfolio__card">
      <div class="portfolio__photo" role="img" aria-label="Objekti foto lisatakse hiljem">
        <svg class="portfolio__photo-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 18h14v-6a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v6h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 30h14v6a4 4 0 0 0 4 4h0a4 4 0 0 0 4-4v-6h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="24" cy="24" r="5.5" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span class="mono portfolio__photo-label">Foto lisatakse</span>
      </div>
      <span class="mono portfolio__object">{item.objekt}</span>
      <h3>{item.pealkiri}</h3>
      <p>{item.kirjeldus}</p>
      <span class="mono portfolio__result">{item.tulemus}</span>
    </article>
  ))}
</div>

<style>
  .portfolio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .portfolio__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .portfolio__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

  .portfolio__photo {
    height: 160px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background:
      radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 1.5px) 0 0 / 14px 14px,
      var(--surface-2);
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }
  .portfolio__photo-icon { width: 30px; height: 30px; }
  .portfolio__photo-label {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .portfolio__card > *:not(.portfolio__photo):not(.portfolio__result) { padding-left: 22px; padding-right: 22px; }
  .portfolio__object {
    display: block;
    margin-top: 18px;
    font-size: 0.72rem;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .portfolio__card h3 { margin-top: 8px; }
  .portfolio__card p { color: var(--ink-2); font-size: 0.9rem; }
  .portfolio__result {
    display: inline-flex;
    align-items: center;
    margin: 0 0 22px 22px;
    color: var(--return);
    background: var(--return-soft);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 5px 10px;
    border-radius: var(--radius);
  }

  @media (max-width: 820px) {
    .portfolio { grid-template-columns: 1fr; }
  }
</style>
