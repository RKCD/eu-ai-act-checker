---
import hinnakiri from '../data/hinnakiri.json';
---

<div class="pricing">
  {hinnakiri.paketid.map((p) => (
    <article class={`price-card ${p.esiletostetud ? 'price-card--featured' : ''}`}>
      {p.esiletostetud && <span class="price-card__flag mono">Enim valitud</span>}
      <h3>{p.nimi}</h3>
      <div class="price-card__price mono">
        {p.hind}<span class="price-card__unit">€/kuu</span>
      </div>
      <p class="mono price-card__year">{p.aastas} €/aastas</p>
      <ul class="price-card__list">
        {p.sisaldub.map((item: string) => <li>{item}</li>)}
        {p.eiSisaldu.map((item: string) => <li class="is-off">{item}</li>)}
      </ul>
      <a href="/#kontakt" class={`btn ${p.esiletostetud ? 'btn--primary' : 'btn--secondary'} price-card__cta`}>Küsi pakkumist</a>
    </article>
  ))}
</div>

<p class="mono pricing__meta">
  Kehtib alates {hinnakiri.kehtibAlates}. {hinnakiri.kaibemaksuMarkus}
</p>

<style>
  .pricing {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .price-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .price-card--featured {
    border-color: var(--supply);
    box-shadow: 0 0 0 1px var(--supply);
  }
  .price-card__flag {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--supply);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--radius);
  }
  .price-card__price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.2rem;
    color: var(--ink);
    margin: 8px 0 0;
  }
  .price-card__unit {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--ink-3);
    margin-left: 4px;
  }
  .price-card__year {
    font-size: 0.78rem;
    color: var(--ink-3);
    margin: 4px 0 20px;
  }
  .price-card__list {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.88rem;
    flex: 1;
  }
  .price-card__list li::before { content: '— '; color: var(--return); }
  .price-card__list li.is-off {
    color: var(--ink-3);
  }
  .price-card__list li.is-off::before { content: '— '; color: var(--line-strong); }
  .price-card__cta { justify-content: center; }

  @media (max-width: 820px) {
    .pricing { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  .pricing__meta { margin-top: 20px; font-size: 0.78rem; color: var(--ink-3); }
</style>
