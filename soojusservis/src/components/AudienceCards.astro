---
const audiences = [
  {
    title: 'Korteriühistu juhatusele',
    text: 'Te ei pea olema tehnik, et üldkoosolekul otsust põhjendada. Meie tabel ja raportid annavad numbrid, mis kannavad ise oma väidet — mitte "usaldage meid", vaid "tagasivool oli 63, on 41".',
  },
  {
    title: 'Haldusfirma objektijuhile',
    text: 'Kümneid maju korraga jälgida käsitsi ei ole mõistlik. Maja tehnopass koondab kõikide objektide tähtajad ühte vaatesse ja saadab meeldetuletuse enne, kui midagi kriitiliseks muutub.',
  },
  {
    title: 'Ärihoone omanikule',
    text: 'Küttekulu on rendipinna ühik, mida keegi ei arva enne, kui see üllatab. Tagasivoolu-audit näitab, kas maja tehnosüsteem töötab nii, nagu selle eest makstakse.',
  },
];
---

<div class="audience">
  {audiences.map((a) => (
    <article class="audience__card">
      <h3>{a.title}</h3>
      <p>{a.text}</p>
    </article>
  ))}
</div>

<style>
  .audience {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .audience__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .audience__card p { color: var(--ink-2); font-size: 0.92rem; margin: 0; }

  @media (max-width: 820px) {
    .audience { grid-template-columns: 1fr; }
  }
</style>
