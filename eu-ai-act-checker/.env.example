# Copy this file to .env and fill in your key.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: require this code before /assess will run a real Claude call.
# Leave blank locally; set a real value in production (e.g. Render env vars)
# so random visitors to your public URL can't spend your API credits.
# This is your own always-valid code — logged as recipient "owner".
APP_PASSWORD=

# Optional: per-recipient access codes, as a JSON object of {code: label}.
# Use this instead of (or alongside) APP_PASSWORD to invite specific people —
# each code is attributed to its label in the audit log, so a shared password
# doesn't blur who ran what. Mint codes with scripts/new_access_code.py; it
# prints the JSON to paste here.
# Example: {"zs2pwkiy":"Kadi - Cleantech Estonia","gvz23nw5":"Peeter"}
ACCESS_CODES=
